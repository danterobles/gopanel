package pages

templ Home() {
 <!DOCTYPE html>
 <html lang="es">
  <head>
   <meta charset="utf-8"/>
   <meta name="viewport" content="width=device-width, initial-scale=1"/>
   <title>GoPanel Pilot</title>
   <link rel="stylesheet" href="/static/app.css"/>
  </head>
  <body class="bg-slate-50 text-slate-900">
   <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-bold">GoPanel Pilot</h1>
    <p class="mt-4">Entorno base listo. Los módulos administrativos se incorporarán por etapas.</p>
   </main>
  </body>
 </html>
}
