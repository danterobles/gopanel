package pages

import "strconv"
import "strings"
import dbgen "gopanel/internal/db/generated"
import "gopanel/internal/modules/products"
import productrepo "gopanel/internal/modules/products/repository"

type ProductListModel struct {
	Rows                  []dbgen.Product
	Options               productrepo.ListOptions
	Total                 int64
	Tenant, Message string
	Create                bool
}

templ ProductPage(tenant string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"historyCacheSize":0,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}]}'/>
			<title>Productos · GoPanel</title>
			<link rel="stylesheet" href="/static/app.css"/><script src="/static/htmx.min.js" defer></script>
		</head>
		<body class="min-h-screen bg-slate-50 text-slate-900">
			<a href="#product-content" class="sr-only focus:not-sr-only">Saltar al contenido</a>
			<header class="border-b border-slate-200 bg-white px-6 py-4"><div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3"><a href="/app" class="font-bold text-indigo-700 underline">GoPanel Pilot</a><span class="text-sm font-medium">{ tenant }</span><a href="/app/tenants/select" class="text-indigo-700 underline">Cambiar empresa</a></div></header>
			<main id="product-content" tabindex="-1" class="mx-auto max-w-6xl px-6 py-8">@body</main>
		</body>
	</html>
}

templ ProductNav() {
	<nav aria-label="Productos" class="mb-6 flex flex-wrap gap-5 text-indigo-700 underline"><a href="/app">Empresa activa</a><a href="/app/products" hx-get="/app/products" hx-target="#product-content" hx-push-url="true">Listado de productos</a></nav>
}

templ ProductProblem(message string) {
	@ProductNav()
	@OperationNotice(message)
}

templ ProductList(model ProductListModel) {
	@ProductNav()
	<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
		<div><h1 class="text-3xl font-bold">Productos</h1><p class="mt-2 text-slate-600">{ model.Tenant }</p></div>
		if model.Create {
			<a href="/app/products/new" hx-get="/app/products/new" hx-target="#product-content" hx-push-url="true" class="rounded bg-indigo-700 px-4 py-3 font-semibold text-white">Nuevo producto</a>
		}
	</div>
	if model.Message!="" {
		<p role="status" class="my-4 rounded border border-green-300 bg-green-50 p-4 text-green-900">{ model.Message }</p>
	}
	<form method="get" action="/app/products" hx-get="/app/products/table" hx-target="#product-results" class="mb-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 sm:grid-cols-2 lg:grid-cols-5">
		<label for="product-search" class="block">Buscar SKU o nombre<input id="product-search" name="search" value={ model.Options.Search } maxlength="180" class="mt-1 w-full rounded border border-slate-400 p-2"/></label>
		<label for="product-status" class="block">Estado<select id="product-status" name="status" class="mt-1 w-full rounded border border-slate-400 bg-white p-2"><option value="">Todos</option><option value="active" selected?={ model.Options.Status=="active" }>Activo</option><option value="inactive" selected?={ model.Options.Status=="inactive" }>Inactivo</option></select></label>
		<label for="product-sort" class="block">Orden<select id="product-sort" name="sort" class="mt-1 w-full rounded border border-slate-400 bg-white p-2"><option value="created_desc" selected?={ model.Options.Sort=="created_desc" }>Más recientes</option><option value="created_asc" selected?={ model.Options.Sort=="created_asc" }>Más antiguos</option><option value="name_asc" selected?={ model.Options.Sort=="name_asc" }>Nombre A–Z</option><option value="name_desc" selected?={ model.Options.Sort=="name_desc" }>Nombre Z–A</option><option value="price_asc" selected?={ model.Options.Sort=="price_asc" }>Precio menor</option><option value="price_desc" selected?={ model.Options.Sort=="price_desc" }>Precio mayor</option></select></label>
		<label for="product-page-size" class="block">Por página<select id="product-page-size" name="page_size" class="mt-1 w-full rounded border border-slate-400 bg-white p-2"><option value="10" selected?={ model.Options.PageSize==10 }>10</option><option value="25" selected?={ model.Options.PageSize==25 }>25</option><option value="50" selected?={ model.Options.PageSize==50 }>50</option></select></label>
		<div class="self-end"><button id="product-filter" class="rounded border border-indigo-700 px-4 py-2 font-semibold text-indigo-800">Aplicar filtros</button><span class="htmx-indicator" role="status">Consultando…</span></div>
	</form>
	<div id="product-results" aria-live="polite">@ProductResults(model)</div>
}

templ ProductResults(model ProductListModel) {
	<p class="mb-4 text-sm text-slate-600">{ productCountLabel(model.Total) } · Página { strconv.Itoa(model.Options.Page) }</p>
	if len(model.Rows)==0 {
		<div class="rounded-xl border border-slate-200 bg-white p-8"><h2 class="text-xl font-semibold">No hay productos para mostrar</h2><p class="mt-2">Revisa los filtros o agrega un producto si tienes permiso.</p></div>
	} else {
		<div tabindex="0" role="region" aria-label="Tabla de productos con desplazamiento horizontal" class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
			<table class="w-full text-left">
				<caption class="sr-only">Productos de la empresa activa</caption><thead class="bg-slate-100"><tr><th scope="col" class="p-4">Nombre</th><th scope="col" class="p-4">SKU</th><th scope="col" class="p-4">Precio (MXN)</th><th scope="col" class="p-4">Estado</th><th scope="col" class="p-4">Creado (UTC)</th><th scope="col" class="p-4">Acción</th></tr></thead>
				<tbody>
					for _,row:=range model.Rows {
						<tr class="border-t border-slate-200">
							<th scope="row" class="p-4 font-medium">{ row.Name }</th>
							<td class="p-4 break-all">{ row.Sku }</td><td class="whitespace-nowrap p-4">{ products.FormatPrice(row.PriceCents) } MXN</td>
							<td class="p-4">
								if row.Status=="active" {
									Activo
								} else {
									Inactivo
								}
							</td>
							<td class="whitespace-nowrap p-4">
								{ row.CreatedAt.UTC().Format("2006-01-02 15:04") }
							</td>
							<td class="p-4"><a href={ templ.SafeURL("/app/products/" + row.ID) } hx-get={ "/app/products/" + row.ID } hx-target="#product-content" hx-push-url="true" aria-label={ "Ver producto " + row.Name } class="text-indigo-700 underline">Ver detalle</a></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	<nav aria-label="Paginación de productos" class="my-6 flex flex-wrap gap-6 text-indigo-700 underline">
		if model.Options.Page>1 {
			<a href={ templ.SafeURL(products.ListURL(model.Options, model.Options.Page-1)) } hx-get={ "/app/products/table?" + strings.TrimPrefix(products.ListURL(model.Options, model.Options.Page-1), "/app/products?") } hx-target="#product-results">Anterior</a>
		}
		if int64(model.Options.Page)*int64(model.Options.PageSize)<model.Total && model.Options.Page*model.Options.PageSize<=100000 {
			<a href={ templ.SafeURL(products.ListURL(model.Options, model.Options.Page+1)) } hx-get={ "/app/products/table?" + strings.TrimPrefix(products.ListURL(model.Options, model.Options.Page+1), "/app/products?") } hx-target="#product-results">Siguiente</a>
		}
	</nav>
}

templ ProductFieldError(field string, errors map[string]string) {
	if errors[field]!="" {
		<p id={ "product-" + field + "-error" } class="mt-1 text-red-800">{ errors[field] }</p>
	}
}

templ ProductForm(csrf, resource string, input products.Input, errors map[string]string) {
	@ProductNav()
	<h1 class="text-3xl font-bold">
		if resource=="" {
			Nuevo producto
		} else {
			Editar producto
		}
	</h1>
	<p class="my-3 text-slate-600">SKU, nombre, precio y estado obligatorios. Moneda MXN; descripción opcional.</p>
	<form method="post" action={ templ.SafeURL(productFormPath(resource)) } hx-post={ productFormPath(resource) } hx-target="#product-content" hx-swap="innerHTML focus-scroll:true" class="mt-6 max-w-3xl space-y-5 rounded-xl border border-slate-200 bg-white p-6">
		<input type="hidden" name="csrf_token" value={ csrf }/>
		if len(errors)>0 {
			<p role="alert" class="rounded border border-red-300 bg-red-50 p-4 text-red-900">Revisa los campos señalados. No se guardaron cambios.</p>
		}
		<div><label for="product-name" class="block font-medium">Nombre</label><input id="product-name" name="name" value={ input.Name } required maxlength="180" autocomplete="organization" aria-invalid={ strconv.FormatBool(errors["name"] != "") } aria-describedby={ productErrorID("name", errors) } class="mt-1 w-full rounded border border-slate-400 p-3"/>@ProductFieldError("name", errors)</div>
		<div><label for="product-sku" class="block font-medium">SKU</label><input id="product-sku" name="sku" value={ input.SKU } required maxlength="80" aria-invalid={ strconv.FormatBool(errors["sku"]!="") } aria-describedby={ productErrorID("sku",errors) } class="mt-1 w-full rounded border border-slate-400 p-3"/>@ProductFieldError("sku",errors)</div>
 <div><label for="product-price" class="block font-medium">Precio (MXN)</label><input id="product-price" name="price" value={ input.Price } required inputmode="decimal" aria-invalid={ strconv.FormatBool(errors["price"]!="") } aria-describedby="product-price-help product-price-error" class="mt-1 w-full rounded border border-slate-400 p-3"/><p id="product-price-help" class="mt-1 text-sm text-slate-600">Usa punto decimal y hasta dos decimales, por ejemplo 1250.50. Sin separador de miles.</p>@ProductFieldError("price",errors)</div>
 <input type="hidden" name="currency" value="MXN"/><p>Moneda: MXN</p>@ProductFieldError("currency",errors)
		<div><label for="product-state" class="block font-medium">Estado</label><select id="product-state" name="status" required aria-invalid={ strconv.FormatBool(errors["status"] != "") } aria-describedby={ productErrorID("status", errors) } class="mt-1 w-full rounded border border-slate-400 bg-white p-3"><option value="" disabled selected?={ input.Status!="active" && input.Status!="inactive" }>Selecciona un estado</option><option value="active" selected?={ input.Status=="active" }>Activo</option><option value="inactive" selected?={ input.Status=="inactive" }>Inactivo</option></select>@ProductFieldError("status", errors)</div>
		<div><label for="product-description" class="block font-medium">Descripción</label><textarea id="product-description" name="description" rows="5" maxlength="5000" aria-invalid={ strconv.FormatBool(errors["description"] != "") } aria-describedby={ productErrorID("description", errors) } class="mt-1 w-full rounded border border-slate-400 p-3">{ input.Description }</textarea>@ProductFieldError("description", errors)</div>
		<div class="flex flex-wrap items-center gap-4"><button id="product-save" class="rounded bg-indigo-700 px-5 py-3 font-semibold text-white">Guardar producto</button><span class="htmx-indicator" role="status">Guardando…</span><a href="/app/products" hx-get="/app/products" hx-target="#product-content" hx-push-url="true" class="text-indigo-700 underline">Cancelar</a></div>
	</form>
}

func productCountLabel(count int64)string{if count==1{return "1 producto"};return strconv.FormatInt(count,10)+" productos"}

func productErrorID(field string, errors map[string]string) string {
	if errors[field] == "" {
		return ""
	}
	return "product-" + field + "-error"
}

func productFormPath(resource string) string {
	if resource == "" {
		return "/app/products/new"
	}
	return "/app/products/" + resource + "/edit"
}

templ ProductDetail(row dbgen.Product, edit, remove bool, message string) {
	@ProductNav()
	<h1 class="text-3xl font-bold">
		{ row.Name }
	</h1>
	if message!="" {
		<p role="status" class="my-4 rounded border border-green-300 bg-green-50 p-4 text-green-900">{ message }</p>
	}
	<dl class="my-6 max-w-3xl space-y-4 rounded-xl border border-slate-200 bg-white p-6">
		<dt class="font-semibold">SKU</dt><dd>{ row.Sku }</dd>
 <dt class="font-semibold">Precio (MXN)</dt><dd>{ products.FormatPrice(row.PriceCents) } MXN</dd>
		<dt class="font-semibold">Estado</dt>
		<dd>
			if row.Status=="active" {
				Activo
			} else {
				Inactivo
			}
		</dd>
		<dt class="font-semibold">Descripción</dt>
		<dd class="whitespace-pre-wrap break-words">
			if row.Description.Valid {
				{ row.Description.String }
			} else {
				Sin descripción
			}
		</dd>
	</dl>
	<div class="flex flex-wrap gap-5">
		if edit {
			<a href={ templ.SafeURL("/app/products/" + row.ID + "/edit") } hx-get={ "/app/products/" + row.ID + "/edit" } hx-target="#product-content" hx-push-url="true" class="rounded bg-indigo-700 px-4 py-3 text-white">Editar producto</a>
		}
		if remove {
			<a href={ templ.SafeURL("/app/products/" + row.ID + "/delete") } hx-get={ "/app/products/" + row.ID + "/delete" } hx-target="#product-content" hx-push-url="true" class="rounded border border-red-700 px-4 py-3 text-red-800">Dar de baja</a>
		}
	</div>
}

templ ProductDelete(csrf string, row dbgen.Product, message string) {
	@ProductNav()
	<h1 class="text-3xl font-bold">Confirmar baja de producto</h1>
	<p class="my-5">Vas a dar de baja a <strong>{ row.Name }</strong>. Dejará de aparecer en listados y consultas. Esta interfaz no ofrece restauración.</p>
	if message!="" {
		@OperationNotice(message)
	}
	<form method="post" action={ templ.SafeURL("/app/products/" + row.ID + "/delete") } hx-post={ "/app/products/" + row.ID + "/delete" } hx-target="#product-content" class="my-6 flex flex-wrap items-center gap-4">
		<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="confirm" value="yes"/>
		<button id="product-delete" class="rounded bg-red-700 px-5 py-3 font-semibold text-white">Confirmar baja</button><span class="htmx-indicator" role="status">Guardando…</span>
		<a href={ templ.SafeURL("/app/products/" + row.ID) } hx-get={ "/app/products/" + row.ID } hx-target="#product-content" hx-push-url="true" class="text-indigo-700 underline">Cancelar</a>
	</form>
}
