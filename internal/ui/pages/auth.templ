package pages

import dbgen "gopanel/internal/db/generated"

templ AuthLayout(title string) {
 <!DOCTYPE html>
 <html lang="es">
  <head>
   <meta charset="utf-8"/>
   <meta name="viewport" content="width=device-width, initial-scale=1"/>
   <meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"historyCacheSize":0,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}]}'/>
   <title>{ title } · GoPanel</title>
   <link rel="stylesheet" href="/static/app.css"/>
   <script src="/static/htmx.min.js" defer></script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
   <main id="main" class="mx-auto max-w-xl px-6 py-12">
    <a href="/" class="text-sm font-semibold text-indigo-700 underline focus-visible:outline-2">GoPanel Pilot</a>
    <h1 class="mt-8 text-3xl font-bold">{ title }</h1>
    { children... }
   </main>
  </body>
 </html>
}

templ LoginPage(csrf, email, message string) {
 @AuthLayout("Iniciar sesión") {
  @LoginForm(csrf,email,message)
 }
}

templ LoginForm(csrf, email, message string) {
 <form id="login-form" method="post" action="/login" hx-post="/login" hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button" class="mt-8 space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <input type="hidden" name="csrf_token" value={ csrf }/>
  if message != "" {
   <p id="login-error" role="alert" class="rounded-md bg-red-50 p-3 text-red-800">{ message }</p>
  }
  <div>
   <label for="email" class="block font-medium">Correo electrónico</label>
   <input id="email" name="email" type="email" autocomplete="username" required maxlength="254" value={ email } class="mt-2 w-full rounded-md border border-slate-400 p-3 focus-visible:outline-2 focus-visible:outline-indigo-600"/>
  </div>
  <div>
   <label for="password" class="block font-medium">Contraseña</label>
   <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="1024" class="mt-2 w-full rounded-md border border-slate-400 p-3 focus-visible:outline-2 focus-visible:outline-indigo-600"/>
  </div>
  <button type="submit" class="rounded-md bg-indigo-700 px-5 py-3 font-semibold text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:opacity-60">Ingresar</button>
  <span class="htmx-indicator text-sm text-slate-600" role="status">Verificando…</span>
  <p class="text-sm text-slate-600">Si necesitas recuperar acceso, contacta con el administrador. La recuperación automática aún no está disponible.</p>
 </form>
}

templ LogoutForm(csrf string) {
 <form method="post" action="/logout" class="mt-8">
  <input type="hidden" name="csrf_token" value={ csrf }/>
  <button type="submit" class="rounded-md border border-slate-400 bg-white px-4 py-2 font-medium focus-visible:outline-2 focus-visible:outline-indigo-600">Cerrar sesión</button>
 </form>
}

templ TenantPage(csrf string, tenants []dbgen.ListActiveTenantsForUserRow, message string, platform bool) {
 @AuthLayout("Seleccionar empresa") {
  @TenantForm(csrf,tenants,message)
  if platform {
 <a href="/platform" class="mt-6 inline-block font-medium text-indigo-700 underline">Administración de plataforma</a>
 }
  @LogoutForm(csrf)
 }
}

templ TenantForm(csrf string, tenants []dbgen.ListActiveTenantsForUserRow, message string) {
 <section id="tenant-form" class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  if message != "" {
   <p role="alert" class="mb-5 rounded-md bg-red-50 p-3 text-red-800">{ message }</p>
  }
  if len(tenants) == 0 {
   <p>No tienes empresas disponibles. Contacta con el administrador.</p>
  } else {
   <form method="post" action="/app/tenants/activate" hx-post="/app/tenants/activate" hx-target="#tenant-form" hx-swap="outerHTML" hx-disabled-elt="find button">
    <input type="hidden" name="csrf_token" value={ csrf }/>
    <label for="tenant" class="block font-medium">Empresa</label>
    <select id="tenant" name="tenant_id" required class="mt-2 w-full rounded-md border border-slate-400 bg-white p-3 focus-visible:outline-2 focus-visible:outline-indigo-600">
     for _, tenant := range tenants {
      <option value={ tenant.ID }>{ tenant.Name } · { tenant.Role }</option>
     }
    </select>
    <button type="submit" class="mt-5 rounded-md bg-indigo-700 px-5 py-3 font-semibold text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:opacity-60">Continuar</button>
    <span class="htmx-indicator text-sm text-slate-600" role="status">Cambiando empresa…</span>
   </form>
  }
 </section>
}

templ ActiveTenant(csrf, name, role string, members, settings bool) {
 @AuthLayout("Empresa activa") {
  <section class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
   <h2 class="text-xl font-semibold">{ name }</h2>
   <p class="mt-2">Rol de tu membresía: <strong>{ role }</strong></p>
   <nav aria-label="Módulos" class="mt-5 flex gap-4 text-indigo-700 underline">
 if members {
 <a href="/app/members">Miembros</a>
 }
 if settings {
 <a href="/app/settings">Configuración</a>
 }
 </nav>
   <a href="/app/tenants/select" class="mt-5 inline-block font-medium text-indigo-700 underline focus-visible:outline-2">Cambiar empresa</a>
  </section>
  @LogoutForm(csrf)
 }
}

templ AuthNotice(message string) {
 <section role="alert" class="mt-8 rounded-md bg-red-50 p-5 text-red-900">
  <p>{ message }</p>
  <a href="/login" class="mt-4 inline-block font-medium underline">Volver a iniciar sesión</a>
 </section>
}

templ AuthError(message string) {
 @AuthLayout("No se pudo completar la solicitud") {
  @AuthNotice(message)
 }
}
