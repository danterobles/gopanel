package pages

import "strconv"
import "gopanel/internal/modules/dashboard/repository"
import "gopanel/internal/ui/components"
import "gopanel/internal/platform/tenancy"
import "gopanel/internal/platform/rbac"

templ DashboardPage(actor tenancy.ActorContext, csrf string, snapshot repository.Snapshot, failed bool) {
	@components.ResourcePage("Dashboard", actor.TenantName, "dashboard-content", Dashboard(actor, csrf, snapshot, failed), "/static/sse.js")
}

templ Dashboard(actor tenancy.ActorContext, csrf string, snapshot repository.Snapshot, failed bool) {
	<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
		<div><h1 class="text-3xl font-bold">Dashboard</h1><p class="mt-2 text-slate-600">{ actor.TenantName } · Rol de tu membresía: <strong>{ actor.Role }</strong></p></div>
		@LogoutForm(csrf)
	</div>
	<nav aria-label="Módulos" class="mb-6 flex flex-wrap gap-5 text-indigo-700 underline">
		<a href="/app/customers">Clientes</a><a href="/app/products">Productos</a>
		if rbac.Can(actor.Role,rbac.MembersRead) {
			<a href="/app/members">Miembros</a>
		}
		if rbac.Can(actor.Role,rbac.TenantSettings) {
			<a href="/app/settings">Configuración</a>
		}
	</nav>
	<section hx-ext="sse" sse-connect="/app/events" sse-close="closed" hx-headers={`{"X-Dashboard-Scope":"` + actor.TenantID + ":" + actor.Role + `"}`} aria-label="Métricas de la empresa">
		<div class="mb-4 flex flex-wrap items-center gap-4">
			<button id="dashboard-refresh" hx-get="/app/dashboard/widgets" hx-target="#dashboard-widgets" hx-disabled-elt="this" hx-sync="#dashboard-widgets:queue last" class="rounded bg-indigo-700 px-4 py-3 font-semibold text-white">Actualizar métricas</button>
			<span class="htmx-indicator" role="status">Consultando métricas…</span><a href="/app" class="text-indigo-700 underline">Recargar página</a>
		</div>
		<p class="mb-5 text-sm text-slate-600">Los cambios se actualizan automáticamente mientras la conexión esté disponible. Puedes actualizar las métricas manualmente.</p>
		<div id="dashboard-widgets" aria-live="polite" hx-get="/app/dashboard/widgets" hx-trigger="sse:ready, sse:invalidate delay:100ms, sse:closed" hx-swap="innerHTML" hx-sync="this:queue last">
			@DashboardWidgets(snapshot, failed)
		</div>
	</section>
}

templ DashboardWidgets(snapshot repository.Snapshot, failed bool) {
	if failed {
		<div role="alert" class="rounded-xl border border-red-300 bg-red-50 p-6 text-red-900"><h2 class="text-xl font-semibold">No se pudieron consultar las métricas</h2><p class="mt-2">Intenta actualizar de nuevo en unos momentos.</p></div>
	} else {
		<p role="status" class="mb-4 text-sm text-slate-600">Métricas consultadas: <time datetime={ snapshot.AsOf.Format("2006-01-02T15:04:05.000000Z07:00") }>{ snapshot.AsOf.Format("2006-01-02 15:04:05") } UTC</time></p>
		<div class="grid gap-4 sm:grid-cols-3">
			@DashboardCard("Clientes activos", snapshot.ActiveCustomers, "active-customers")
			@DashboardCard("Productos activos", snapshot.ActiveProducts, "active-products")
			@DashboardCard("Clientes en últimos 30 días", snapshot.RecentCustomers, "recent-customers")
		</div>
		<section class="mt-6 rounded-xl border border-slate-200 bg-white p-6" aria-labelledby="customer-chart-title">
			<h2 id="customer-chart-title" class="text-xl font-semibold">Clientes creados por día</h2>
			<p class="my-3 text-sm text-slate-600">30 días calendario UTC, desde { snapshot.Start.Format("2006-01-02") } hasta el momento de consulta. Incluye activos e inactivos; excluye bajas lógicas.</p>
			if snapshot.RecentCustomers==0 {
				<p class="my-4 rounded bg-slate-100 p-4">No hay clientes creados en este período.</p>
			}
			<svg viewBox="0 0 720 200" role="img" aria-label="Clientes creados en los últimos 30 días; valores diarios en la tabla desplegable" class="w-full text-indigo-600">
				<title>Clientes creados por día en UTC</title>
				<line x1="0" y1="170" x2="720" y2="170" stroke="currentColor"></line>
				for i,day:=range snapshot.Days {
					<rect x={ strconv.Itoa(i*24 + 3) } y={ strconv.Itoa(170 - day.Percent*150/100) } width="18" height={ strconv.Itoa(day.Percent * 150 / 100) } fill="currentColor"><title>{ day.Date.Format("2006-01-02") }: { strconv.FormatInt(day.Total,10) } clientes</title></rect>
				}
				<text x="0" y="194" font-size="12" fill="currentColor">{ snapshot.Start.Format("02/01") }</text>
				<text x="660" y="194" font-size="12" fill="currentColor">{ snapshot.AsOf.Format("02/01") }</text>
			</svg>
			<details class="mt-4">
				<summary class="cursor-pointer font-medium text-indigo-700 underline">Ver datos diarios (UTC)</summary>
				<table class="mt-4 w-full text-left">
					<caption class="sr-only">Clientes creados cada día, incluyendo días sin registros</caption><thead><tr><th scope="col" class="p-2">Fecha UTC</th><th scope="col" class="p-2">Clientes</th></tr></thead>
					<tbody>
						for _,day:=range snapshot.Days {
							<tr class="border-t border-slate-200"><th scope="row" class="p-2 font-normal">{ day.Date.Format("2006-01-02") }</th><td class="p-2">{ strconv.FormatInt(day.Total,10) }</td></tr>
						}
					</tbody>
				</table>
			</details>
		</section>
	}
}

templ DashboardCard(label string, value int64, id string) {
	<section class="rounded-xl border border-slate-200 bg-white p-5"><h2 class="text-sm font-medium text-slate-600">{ label }</h2><p id={ id } class="mt-3 text-3xl font-bold">{ strconv.FormatInt(value,10) }</p></section>
}
