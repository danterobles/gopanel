package pages

import "strconv"
import "gopanel/internal/ui/components"
import dbgen "gopanel/internal/db/generated"
import "gopanel/internal/modules/customers"
import customerrepo "gopanel/internal/modules/customers/repository"

type CustomerListModel struct {
	Rows            []dbgen.Customer
	Options         customerrepo.ListOptions
	Total           int64
	Tenant, Message string
	Create          bool
}

templ CustomerPage(tenant string, body templ.Component) {
	@components.ResourcePage("Clientes", tenant, "customer-content", body)
}

templ CustomerNav() {
	@components.ResourceNav("Clientes", "/app/customers", "#customer-content")
}

templ CustomerProblem(message string) {
	@CustomerNav()
	@OperationNotice(message)
}

templ CustomerList(model CustomerListModel) {
	@CustomerNav()
	<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
		<div><h1 class="text-3xl font-bold">Clientes</h1><p class="mt-2 text-slate-600">{ model.Tenant }</p></div>
		if model.Create {
			<a href="/app/customers/new" hx-get="/app/customers/new" hx-target="#customer-content" hx-push-url="true" class="rounded bg-indigo-700 px-4 py-3 font-semibold text-white">Nuevo cliente</a>
		}
	</div>
	@components.Success(model.Message)
	<form method="get" action="/app/customers" hx-get="/app/customers/table" hx-target="#customer-results" class="mb-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 sm:grid-cols-2 lg:grid-cols-5">
		<label for="customer-search" class="block">Buscar nombre o correo<input id="customer-search" name="search" value={ model.Options.Search } maxlength="180" class="mt-1 w-full rounded border border-slate-400 p-2"/></label>
		<label for="customer-status" class="block">Estado<select id="customer-status" name="status" class="mt-1 w-full rounded border border-slate-400 bg-white p-2"><option value="">Todos</option><option value="active" selected?={ model.Options.Status=="active" }>Activo</option><option value="inactive" selected?={ model.Options.Status=="inactive" }>Inactivo</option></select></label>
		<label for="customer-sort" class="block">Orden<select id="customer-sort" name="sort" class="mt-1 w-full rounded border border-slate-400 bg-white p-2"><option value="created_desc" selected?={ model.Options.Sort=="created_desc" }>Más recientes</option><option value="created_asc" selected?={ model.Options.Sort=="created_asc" }>Más antiguos</option><option value="name_asc" selected?={ model.Options.Sort=="name_asc" }>Nombre A–Z</option><option value="name_desc" selected?={ model.Options.Sort=="name_desc" }>Nombre Z–A</option></select></label>
		<label for="customer-page-size" class="block">Por página<select id="customer-page-size" name="page_size" class="mt-1 w-full rounded border border-slate-400 bg-white p-2"><option value="10" selected?={ model.Options.PageSize==10 }>10</option><option value="25" selected?={ model.Options.PageSize==25 }>25</option><option value="50" selected?={ model.Options.PageSize==50 }>50</option></select></label>
		<div class="self-end"><button id="customer-filter" class="rounded border border-indigo-700 px-4 py-2 font-semibold text-indigo-800">Aplicar filtros</button><span class="htmx-indicator" role="status">Consultando…</span></div>
	</form>
	<div id="customer-results" aria-live="polite">@CustomerResults(model)</div>
}

templ CustomerResults(model CustomerListModel) {
	<p class="mb-4 text-sm text-slate-600">{ customerCountLabel(model.Total) } · Página { strconv.Itoa(model.Options.Page) }</p>
	if len(model.Rows)==0 {
		<div class="rounded-xl border border-slate-200 bg-white p-8"><h2 class="text-xl font-semibold">No hay clientes para mostrar</h2><p class="mt-2">Revisa los filtros o agrega un cliente si tienes permiso.</p></div>
	} else {
		@components.ResourceTable("Clientes de la empresa activa", []string{"Nombre", "Correo", "Estado", "Creado (UTC)", "Acción"}) {
			for _,row:=range model.Rows {
				<tr class="border-t border-slate-200">
					<th scope="row" class="p-4 font-medium">{ row.Name }</th>
					<td class="p-4 break-all">
						if row.Email.Valid {
							{ row.Email.String }
						} else {
							—
						}
					</td>
					<td class="p-4">
						if row.Status=="active" {
							Activo
						} else {
							Inactivo
						}
					</td>
					<td class="whitespace-nowrap p-4">
						{ row.CreatedAt.UTC().Format("2006-01-02 15:04") }
					</td>
					<td class="p-4"><a href={ templ.SafeURL("/app/customers/" + row.ID) } hx-get={ "/app/customers/" + row.ID } hx-target="#customer-content" hx-push-url="true" aria-label={ "Ver cliente " + row.Name } class="text-indigo-700 underline">Ver detalle</a></td>
				</tr>
			}
		}
	}
	@components.Pagination("Paginación de clientes", "/app/customers", "#customer-results", customerPrevious(model), customerNext(model))
}

templ CustomerFieldError(field string, errors map[string]string) {
	@components.FieldError("customer", field, errors)
}

templ CustomerForm(csrf, resource string, input customers.Input, errors map[string]string) {
	@CustomerNav()
	<h1 class="text-3xl font-bold">
		if resource=="" {
			Nuevo cliente
		} else {
			Editar cliente
		}
	</h1>
	<p class="my-3 text-slate-600">Nombre y estado obligatorios. El resto de campos es opcional.</p>
	@components.ResourceForm(customerFormPath(resource), "#customer-content", csrf, errors) {
		@components.TextField("customer", "name", "Nombre", input.Name, "text", "organization", 180, true, errors)
		@components.TextField("customer", "email", "Correo", input.Email, "email", "email", 254, false, errors)
		@components.TextField("customer", "phone", "Teléfono", input.Phone, "tel", "tel", 40, false, errors)
		@components.StateField("customer", input.Status, errors)
		@components.TextAreaField("customer", "notes", "Notas", input.Notes, 5000, errors)
		@components.FormActions("customer", "Guardar cliente", "/app/customers", "#customer-content")
	}
}

func customerCountLabel(count int64) string {
	if count == 1 {
		return "1 cliente"
	}
	return strconv.FormatInt(count, 10) + " clientes"
}

func customerErrorID(field string, errors map[string]string) string {
	return components.ErrorID("customer", field, errors)
}

func customerFormPath(resource string) string {
	if resource == "" {
		return "/app/customers/new"
	}
	return "/app/customers/" + resource + "/edit"
}

templ CustomerDetail(row dbgen.Customer, edit, remove bool, message string) {
	@CustomerNav()
	<h1 class="text-3xl font-bold">
		{ row.Name }
	</h1>
	@components.Success(message)
	<dl class="my-6 max-w-3xl space-y-4 rounded-xl border border-slate-200 bg-white p-6">
		<dt class="font-semibold">Correo</dt>
		<dd class="break-all">
			if row.Email.Valid {
				{ row.Email.String }
			} else {
				Sin correo
			}
		</dd>
		<dt class="font-semibold">Teléfono</dt>
		<dd>
			if row.Phone.Valid {
				{ row.Phone.String }
			} else {
				Sin teléfono
			}
		</dd>
		<dt class="font-semibold">Estado</dt>
		<dd>
			if row.Status=="active" {
				Activo
			} else {
				Inactivo
			}
		</dd>
		<dt class="font-semibold">Notas</dt>
		<dd class="whitespace-pre-wrap break-words">
			if row.Notes.Valid {
				{ row.Notes.String }
			} else {
				Sin notas
			}
		</dd>
	</dl>
	<div class="flex flex-wrap gap-5">
		if edit {
			<a href={ templ.SafeURL("/app/customers/" + row.ID + "/edit") } hx-get={ "/app/customers/" + row.ID + "/edit" } hx-target="#customer-content" hx-push-url="true" class="rounded bg-indigo-700 px-4 py-3 text-white">Editar cliente</a>
		}
		if remove {
			<a href={ templ.SafeURL("/app/customers/" + row.ID + "/delete") } hx-get={ "/app/customers/" + row.ID + "/delete" } hx-target="#customer-content" hx-push-url="true" class="rounded border border-red-700 px-4 py-3 text-red-800">Dar de baja</a>
		}
	</div>
}

templ CustomerDelete(csrf string, row dbgen.Customer, message string) {
	@CustomerNav()
	<h1 class="text-3xl font-bold">Confirmar baja de cliente</h1>
	<p class="my-5">Vas a dar de baja a <strong>{ row.Name }</strong>. Dejará de aparecer en listados y consultas. Esta interfaz no ofrece restauración.</p>
	if message!="" {
		@OperationNotice(message)
	}
	<form method="post" action={ templ.SafeURL("/app/customers/" + row.ID + "/delete") } hx-post={ "/app/customers/" + row.ID + "/delete" } hx-target="#customer-content" class="my-6 flex flex-wrap items-center gap-4">
		<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="confirm" value="yes"/>
		<button id="customer-delete" class="rounded bg-red-700 px-5 py-3 font-semibold text-white">Confirmar baja</button><span class="htmx-indicator" role="status">Guardando…</span>
		<a href={ templ.SafeURL("/app/customers/" + row.ID) } hx-get={ "/app/customers/" + row.ID } hx-target="#customer-content" hx-push-url="true" class="text-indigo-700 underline">Cancelar</a>
	</form>
}

func customerPrevious(model CustomerListModel) string {
	if model.Options.Page <= 1 {
		return ""
	}
	return customers.ListURL(model.Options, model.Options.Page-1)
}
func customerNext(model CustomerListModel) string {
	if int64(model.Options.Page)*int64(model.Options.PageSize) >= model.Total || model.Options.Page*model.Options.PageSize > 100000 {
		return ""
	}
	return customers.ListURL(model.Options, model.Options.Page+1)
}
