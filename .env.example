APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=goconcept
DB_USER=root
# Completar solo en .env privado. No reutilizar credenciales de MySQL en usuarios seed.
DB_PASSWORD=
DB_TLS=false
# Solo si se usa la alternativa Compose; no necesario para desarrollo nativo:
# MYSQL_ROOT_PASSWORD=

# Política de identidad (defaults; las credenciales seed no se cambian):
SESSION_ABSOLUTE_TTL=12h
SESSION_IDLE_TTL=30m
SESSION_TOUCH_INTERVAL=1m
AUTH_CLEANUP_INTERVAL=5m
LOGIN_ATTEMPTS_PER_MINUTE=10
